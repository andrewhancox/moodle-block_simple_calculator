{{!
    @template block_simple_calculator/simple_calculator

    The calculator display and keypad, used both inline in the block and in the popup.

    Classes required for JS:
    * data-calculator-number, data-calculator-operation, data-calculator-equals,
      data-calculator-all-clear and data-calculator-delete identify each kind of button.

    Data attributes required for JS:
    * data-keybinding - the keyboard key that presses the button in popup mode.

    Context variables required for this template:
    * none

    Example context (json):
    {}
}}
<div class="block-calculator-grid mx-auto">
    <div class="block-calculator-output d-flex flex-column align-items-end justify-content-end bg-dark text-white rounded p-2 text-break">
        <div id="data-block-calculator-previous-operand" class="small text-white-50"></div>
        <div id="data-block-calculator-current-operand" class="h4 mb-0" aria-live="polite"></div>
    </div>
    <button type="button" class="data-calculator-all-clear block-calculator-span-two btn btn-outline-danger" data-keybinding="Delete">AC</button>
    <button type="button" class="data-calculator-delete btn btn-outline-secondary" data-keybinding="Backspace">DEL</button>
    <button type="button" class="data-calculator-operation btn btn-secondary" data-keybinding="/">÷</button>
    <button type="button" class="data-calculator-number btn btn-light" data-keybinding="1">1</button>
    <button type="button" class="data-calculator-number btn btn-light" data-keybinding="2">2</button>
    <button type="button" class="data-calculator-number btn btn-light" data-keybinding="3">3</button>
    <button type="button" class="data-calculator-operation btn btn-secondary" data-keybinding="*">*</button>
    <button type="button" class="data-calculator-number btn btn-light" data-keybinding="4">4</button>
    <button type="button" class="data-calculator-number btn btn-light" data-keybinding="5">5</button>
    <button type="button" class="data-calculator-number btn btn-light" data-keybinding="6">6</button>
    <button type="button" class="data-calculator-operation btn btn-secondary" data-keybinding="+">+</button>
    <button type="button" class="data-calculator-number btn btn-light" data-keybinding="7">7</button>
    <button type="button" class="data-calculator-number btn btn-light" data-keybinding="8">8</button>
    <button type="button" class="data-calculator-number btn btn-light" data-keybinding="9">9</button>
    <button type="button" class="data-calculator-operation btn btn-secondary" data-keybinding="-">-</button>
    <button type="button" class="data-calculator-number btn btn-light" data-keybinding=".">.</button>
    <button type="button" class="data-calculator-number btn btn-light" data-keybinding="0">0</button>
    <button type="button" class="data-calculator-equals block-calculator-span-two btn btn-primary" data-keybinding="=">=</button>
</div>
